+#include <kernel.h>
+#endif
 
 #include <tgfclient.h>
 #include <portability.h>
@@ -72,6 +75,11 @@ static int usedFG = 0;
 #ifdef USE_RANDR_EXT
 static char	**Res = NULL;
 static int nbRes = 0;
+#elif defined(__riscos__)
+// RISC OS: everything is drawn by software OpenGL, and drawing time grows
+// with the number of pixels, so the list starts small.
+static char	*Res[] = {"320x240", "400x300", "480x360", "512x384", "640x480", "800x600", "1024x768", "1280x720", "1280x1024", "1600x900", "1920x1080"};
+static const int nbRes = sizeof(Res) / sizeof(Res[0]);
 #else // USE_RANDR_EXT
 static char	*Res[] = {"640x480", "800x600", "1024x768", "1152x768", "1152x864", "1200x854", "1200x960", "1280x720", "1280x1024", "1400x900", "1600x900", "1600x1200", "1680x1050", "1920x1200", "320x200"};
 static const int nbRes = sizeof(Res) / sizeof(Res[0]);
@@ -519,6 +527,22 @@ GfScrReinit(void * /* dummy */)
 	}
 
 	retcode = execlp(cmd, cmdarg, (const char *)NULL);
+#elif defined(__riscos__)
+	/* RISC OS: a program can't replace itself (no exec), so the new screen
+	   settings, now saved, take effect when TORCS is started again. */
+	{
+		GfScrShutdown();
+		_kernel_oserror err;
+		_kernel_swi_regs r;
+		err.errnum = 0;
+		snprintf(err.errmess, sizeof(err.errmess),
+			"The new screen settings are saved. TORCS will now quit: start it again to use them.");
+		r.r[0] = (int)&err;
+		r.r[1] = 1 | 16;	/* OK box, no "Error from" prefix */
+		r.r[2] = (int)"TORCS";
+		_kernel_swi(0x400DF /* Wimp_ReportError */, &r, &r);
+		exit(0);
+	}
 #else
 	GfScrShutdown();
 	
