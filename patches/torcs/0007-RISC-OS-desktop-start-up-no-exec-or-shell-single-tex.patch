index 050329b..63224a6 100644
--- a/src/libs/tgfclient/screen.cpp
+++ b/src/libs/tgfclient/screen.cpp
@@ -33,6 +33,9 @@
 #else
 #include <process.h>
 #endif /* WIN32 */
