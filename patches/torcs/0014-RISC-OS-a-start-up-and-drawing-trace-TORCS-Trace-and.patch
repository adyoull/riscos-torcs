diff --git a/src/libs/tgf/riscostrace.cpp b/src/libs/tgf/riscostrace.cpp
new file mode 100644
index 0000000..ac10ed3
--- /dev/null
+++ b/src/libs/tgf/riscostrace.cpp
@@ -0,0 +1,164 @@
+/***************************************************************************
+
+    file                 : riscostrace.cpp
+    RISC OS port (riscos-torcs): a trace of start-up and drawing, written
+    to the log (stdout, TORCS$Log), for finding where TORCS stops.
+    (C) 2026 Andrew Youll
+
+    Off unless the variable TORCS$Trace is set (to anything). Then:
+    - riscosTrace() writes a line with the time since start (seconds);
+    - riscosTraceStage() notes where the main thread is (not written);
+    - riscosTraceFrame() counts frames, writing the first five and every
+      hundredth;
+    - a watchdog thread writes where the main thread last was if it has
+      made no progress for 5 seconds, and again every 10 seconds. If the
+      main thread is stuck inside a SWI, the watchdog can't run either,
+      so the log then just stops at the last stage.
+    riscosNoSound() is true if TORCS$NoSound is set: the menu music and
+    the race sound are then left off (OpenAL isn't started).
+
+ ***************************************************************************/
+
+/***************************************************************************
+ *                                                                         *
+ *   This program is free software; you can redistribute it and/or modify  *
+ *   it under the terms of the GNU General Public License as published by  *
+ *   the Free Software Foundation; either version 2 of the License, or     *
+ *   (at your option) any later version.                                   *
+ *                                                                         *
+ ***************************************************************************/
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdarg.h>
+#include <pthread.h>
+#include <unistd.h>
+#include <time.h>
+#ifdef __riscos__
+#include <kernel.h>
+#endif
+
+#include "tgf.h"
+
+int riscosTraceOn = 0;
+
+static volatile unsigned traceSeq;		/* changes whenever the main thread reports */
+static const char * volatile traceStage = "start";
+static volatile unsigned traceFrames;
+static unsigned traceStart;
+
+/* Centiseconds. */
+static unsigned
+traceNow(void)
+{
+#ifdef __riscos__
+	_kernel_swi_regs r;
+	_kernel_swi(0x42 /* OS_ReadMonotonicTime */, &r, &r);
+	return (unsigned)r.r[0];
+#else
+	struct timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (unsigned)(ts.tv_sec * 100 + ts.tv_nsec / 10000000);
+#endif
+}
+
+static void
+traceLine(const char *fmt, va_list ap)
+{
+	unsigned t = traceNow() - traceStart;
+	char line[300];
+	vsnprintf(line, sizeof(line), fmt, ap);
+	printf("[trace %u.%02u] %s\n", t / 100, t % 100, line);
+	fflush(stdout);
+}
+
+void
+riscosTrace(const char *fmt, ...)
+{
+	if (!riscosTraceOn) {
+		return;
+	}
+	va_list ap;
+	va_start(ap, fmt);
+	traceLine(fmt, ap);
+	va_end(ap);
+	traceSeq++;
+}
+
+static void
+traceWatchdogLine(const char *fmt, ...)
+{
+	va_list ap;
+	va_start(ap, fmt);
+	traceLine(fmt, ap);
+	va_end(ap);
+}
+
+void
+riscosTraceStage(const char *stage)
+{
+	traceStage = stage;
+	traceSeq++;
+}
+
+void
+riscosTraceFrame(const char *where)
+{
+	unsigned n = ++traceFrames;
+	traceStage = where;
+	traceSeq++;
+	if (riscosTraceOn && (n <= 5 || n % 100 == 0)) {
+		riscosTrace("%s: frame %u", where, n);
+	}
+}
+
+static void *
+traceWatchdog(void *)
+{
+	unsigned last = traceSeq, still = 0;
+	for (;;) {
+		sleep(1);
+		if (traceSeq != last) {
+			last = traceSeq;
+			still = 0;
+			continue;
+		}
+		still++;
+		if (still == 5 || (still > 5 && still % 10 == 5)) {
+			traceWatchdogLine("watchdog: no progress for %u s; the main thread was last at: %s (%u frames)",
+			                  still, traceStage, traceFrames);
+		}
+	}
+	return NULL;
+}
+
+void
+riscosTraceInit(void)
+{
+	const char *v = getenv("TORCS$Trace");
+	if (v == NULL || *v == 0) {
+		return;
+	}
+	riscosTraceOn = 1;
+	traceStart = traceNow();
+	riscosTrace("trace on (TORCS$Trace)%s", riscosNoSound() ? "; sound off (TORCS$NoSound)" : "");
+	pthread_t t;
+	pthread_attr_t a;
+	pthread_attr_init(&a);
+	pthread_attr_setdetachstate(&a, PTHREAD_CREATE_DETACHED);
+	if (pthread_create(&t, &a, traceWatchdog, NULL) != 0) {
+		riscosTrace("no watchdog thread");
+	}
+	pthread_attr_destroy(&a);
+}
+
+int
+riscosNoSound(void)
+{
+	static int noSound = -1;
+	if (noSound < 0) {
+		const char *v = getenv("TORCS$NoSound");
+		noSound = (v != NULL && *v != 0);
+	}
+	return noSound;
+}
