diff --git a/src/libs/tgfclient/guifont.cpp b/src/libs/tgfclient/guifont.cpp
index b47364a..78fdf5f 100644
--- a/src/libs/tgfclient/guifont.cpp
+++ b/src/libs/tgfclient/guifont.cpp
@@ -170,16 +170,45 @@ GfuiFontClass::GfuiFontClass(char *FileName)
 	font->Tex = Tex;
 	//Set texture attributes
 	glBindTexture(GL_TEXTURE_2D, Tex);
+#if defined(__riscos__) || defined(TORCS_SOFTWARE_GL)
+	// Software OpenGL: an RGBA texture in GL_CLAMP_TO_EDGE keeps the text
+	// (menus, the race display) on Mesa's fast textured-triangle path;
+	// luminance-alpha in GL_CLAMP took the general path.
+	glTexParameterf(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+	glTexParameterf(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+#else
 	glTexParameterf(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP);
 	glTexParameterf(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP);
+#endif
 	glTexParameterf(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
 	glTexParameterf(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
 	glTexEnvf(GL_TEXTURE_ENV, GL_TEXTURE_ENV_MODE, GL_MODULATE);
 
 	//Create texture
+#if defined(__riscos__) || defined(TORCS_SOFTWARE_GL)
+	{
+		int n = font->TexWidth * font->TexHeight;
+		unsigned char *rgba = (unsigned char *)malloc(n * 4);
+		if (rgba != NULL) {
+			for (int i = 0; i < n; i++) {
+				rgba[i * 4] = rgba[i * 4 + 1] = rgba[i * 4 + 2] = TexBytes[i * 2];
+				rgba[i * 4 + 3] = TexBytes[i * 2 + 1];
+			}
+			glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, font->TexWidth,
+				 font->TexHeight, 0, GL_RGBA,
+				 GL_UNSIGNED_BYTE, (void *)rgba);
+			free(rgba);
+		} else {
+			glTexImage2D(GL_TEXTURE_2D, 0, 2, font->TexWidth,
+				 font->TexHeight, 0, GL_LUMINANCE_ALPHA,
+				 GL_UNSIGNED_BYTE, (void *)TexBytes);
+		}
+	}
+#else
 	glTexImage2D(GL_TEXTURE_2D, 0, 2, font->TexWidth,
 		 font->TexHeight, 0, GL_LUMINANCE_ALPHA,
 		 GL_UNSIGNED_BYTE, (void *)TexBytes);
+#endif
 
 	//Clean up
 	free(TexBytes);
