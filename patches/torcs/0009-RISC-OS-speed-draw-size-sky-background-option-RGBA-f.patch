 }
 
 /* The settings files the Linux launcher copies into ~/.torcs
-   (setup_linux.sh, made from the CONFIG lists in the Makefiles). They are
-   copied when missing; a newer copy in the game (a new version) replaces
-   the old one, which is kept as <file>.old, as on Linux. */
+   (setup_linux.sh, made from the CONFIG lists in the Makefiles). */
 static const char *const configFiles[] = {
 	"config/raceengine.xml",
 	"config/style.xsl",
@@ -161,12 +159,93 @@ static const char *const configFiles[] = {
 	NULL
 };
 
+#ifdef __riscos__
+/* The first run's screen settings (screen.xml was just copied, on the
+   first run or the first run of a new version): full
+   screen, drawn at a reduced size and stretched over the screen.
+   riscos-mesa's freeglut does this for GLUT's game mode, which TORCS uses
+   for full screen: the picture is drawn at the size TORCS asks for (the
+   screen.xml x and y) and stretched by a hardware overlay (VideoOverlay on
+   a Pi) or by the plot. Drawing time grows with the number of pixels, so
+   this is the biggest speed setting there is. The size has the screen's
+   shape (so the picture isn't stretched out of shape) and is 360 pixels
+   high. Options > Display changes it; "Window mode" there gives a window
+   of that size instead. */
+static void
+riscosScreenDefaults(const char *path)
+{
+	_kernel_swi_regs r;
+	int sw = 1920, sh = 1080;
+
+	r.r[0] = -1;
+	r.r[1] = 11;	/* XWindLimit: width - 1 */
+	if (_kernel_swi(0x35 /* OS_ReadModeVariable */, &r, &r) == NULL && r.r[2] > 0) {
+		sw = r.r[2] + 1;
+	}
+	r.r[0] = -1;
+	r.r[1] = 12;	/* YWindLimit: height - 1 */
+	if (_kernel_swi(0x35, &r, &r) == NULL && r.r[2] > 0) {
+		sh = r.r[2] + 1;
+	}
+	int h = 360;
+	int w = ((sw * h / sh) + 4) & ~7;
+	if (w < 320 || w > 1280) {
+		w = 480;
+	}
+
+	void *hdle = GfParmReadFile(path, GFPARM_RMODE_STD | GFPARM_RMODE_CREAT);
+	if (hdle == NULL) {
+		return;
+	}
+	GfParmSetNum(hdle, "Screen Properties", "x", NULL, w);
+	GfParmSetNum(hdle, "Screen Properties", "y", NULL, h);
+	GfParmSetNum(hdle, "Screen Properties", "window width", NULL, w);
+	GfParmSetNum(hdle, "Screen Properties", "window height", NULL, h);
+	GfParmSetStr(hdle, "Screen Properties", "fullscreen", "yes");
+	GfParmWriteFile(NULL, hdle, "Screen");
+	GfParmReleaseHandle(hdle);
+	printf("RISC OS setup: screen %dx%d, drawing at %dx%d, full screen\n", sw, sh, w, h);
+}
+#endif
+
+/* Read the first line of a small file into buf ("" if there's none). */
+static void
+readLine(const char *path, char *buf, size_t size)
+{
+	buf[0] = 0;
+	FILE *f = fopen(path, "r");
+	if (f == NULL) {
+		return;
+	}
+	if (fgets(buf, (int)size, f) == NULL) {
+		buf[0] = 0;
+	}
+	fclose(f);
+	buf[strcspn(buf, "\r\n")] = 0;
+}
+
+/* Copy the settings files into the settings directory. A file that's
+   missing is copied. When the application is a different version from the
+   one that last set the directory up (the file Version in the application,
+   written by package.sh, against riscos-version in the settings), all of
+   them are replaced, the old ones kept as <file>.old, as the Linux launcher
+   does when the game's copies are newer. Versions are compared rather than
+   file dates: a Pi without a network or clock battery can start with a
+   date earlier than the files in the zip, and the settings saved in the
+   game would then always look older and be replaced at every start. */
 static void
 setupLocalDir(void)
 {
 	char from[1024], to[1024], old[1024];
+	char appVersion[64], localVersion[64];
 	struct stat sf, st;
 
+	snprintf(from, sizeof(from), "%sVersion", GetDataDir());
+	readLine(from, appVersion, sizeof(appVersion));
+	snprintf(to, sizeof(to), "%sriscos-version", GetLocalDir());
+	readLine(to, localVersion, sizeof(localVersion));
+	bool update = strcmp(appVersion, localVersion) != 0;
+
 	for (int i = 0; configFiles[i] != NULL; i++) {
 		snprintf(from, sizeof(from), "%s%s", GetDataDir(), configFiles[i]);
 		snprintf(to, sizeof(to), "%s%s", GetLocalDir(), configFiles[i]);
@@ -174,7 +253,7 @@ setupLocalDir(void)
 			continue;
 		}
 		if (stat(to, &st) == 0) {
-			if (sf.st_mtime <= st.st_mtime) {
+			if (!update) {
 				continue;
 			}
 			snprintf(old, sizeof(old), "%s.old", to);
@@ -191,6 +270,22 @@ setupLocalDir(void)
 			}
 		}
 		copyFile(from, to);
+#ifdef __riscos__
+		if (strcmp(configFiles[i], "config/screen.xml") == 0) {
+			riscosScreenDefaults(to);
+		}
+#endif
+	}
+
+	if (update) {
+		snprintf(to, sizeof(to), "%sriscos-version", GetLocalDir());
+		FILE *f = fopen(to, "w");
+		if (f != NULL) {
+			fprintf(f, "%s\n", appVersion);
+			fclose(f);
+		}
+		printf("RISC OS setup: settings set up for version %s (were %s)\n",
+		       appVersion[0] ? appVersion : "?", localVersion[0] ? localVersion : "none");
 	}
 }
 
