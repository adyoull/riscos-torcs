diff --git a/src/Makefile b/src/Makefile
index 140440c..25e00bc 100644
--- a/src/Makefile
+++ b/src/Makefile
@@ -23,9 +23,16 @@ SHIPSUBDIRS	= drivers modules libs raceman
 
 EXPINCDIRS	= interfaces libs linux modules
 
+ifdef RISCOS_STATIC
+# RISC OS: the tools (trackgen, accc...) are host programs; not built.
+TOOLSUBDIRS	= libs linux
+
+SUBDIRS		= libs linux modules drivers
+else
 TOOLSUBDIRS	= libs tools linux
 
 SUBDIRS		= libs linux modules drivers tools
+endif
 
 SRCDOC		= yes
 
diff --git a/src/linux/Makefile b/src/linux/Makefile
index 6bb4ebd..402c3d7 100644
--- a/src/linux/Makefile
+++ b/src/linux/Makefile
@@ -21,9 +21,13 @@ TOOLSCRIPT  = torcs
 
 PROGRAM = torcs-bin
 
+ifdef RISCOS_STATIC
+SOURCES = main.cpp riscosspec.cpp riscosplatform.cpp
+else
 SOURCES = main.cpp linuxspec.cpp
 
 LDFLAGS = -rdynamic
+endif
 
 SOLIBS  =  -lracescreens  \
 	   -lrobottools   \
